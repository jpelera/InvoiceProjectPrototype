<Window x:Class="InvoiceProjectPrototype.Main.wndMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceProjectPrototype.Main"
        mc:Ignorable="d"
        Title="Main Window" Height="500" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="297*"/>
            <RowDefinition Height="79*"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="File">
                <MenuItem x:Name="MenuSearchForInvoice" Header="Search for Invoice" Click="MenuSearchForInvoice_Click"/>
                <MenuItem x:Name="MenuManageItems" Header="Manage Items" Click="MenuManageItems_Click"/>
            </MenuItem>
        </Menu>
        <TextBox x:Name="TextInvoiceNumber" HorizontalAlignment="Left" Margin="44,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" IsReadOnly="True" Text="Invoice Number"/>
        <DatePicker x:Name="PickerInvoiceDate" HorizontalAlignment="Left" Margin="469,0,0,0" Grid.Row="1" VerticalAlignment="Center"/>
        <ComboBox x:Name="ComboItemSelection" HorizontalAlignment="Left" Margin="273,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="120"/>
        <DataGrid x:Name="DataGridInvoiceItems" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <TextBlock x:Name="TextTotalCost" HorizontalAlignment="Left" Margin="23,10,0,0" Grid.Row="3" TextWrapping="Wrap" Text="$0.00" VerticalAlignment="Top"/>
        <Button x:Name="ButtonSaveInvoice" Content="Save Invoice" HorizontalAlignment="Left" Margin="298,42,0,0" Grid.Row="3" VerticalAlignment="Top" Click="ButtonSaveInvoice_Click"/>
        <Button x:Name="ButtonDeleteInvoice" Content="Delete Invoice" HorizontalAlignment="Left" Margin="412,42,0,0" Grid.Row="3" VerticalAlignment="Top" Click="ButtonDeleteInvoice_Click"/>
    </Grid>
</Window>
